# TattvaCo — environment configuration.
# Copy to .env.local for development. Never commit real values. All secrets are server-side only.
# Values marked PROVISIONAL implement OPEN product decisions and need product-owner approval.

# ---------------------------------------------------------------- core
APP_URL=http://localhost:3000
# Required in production (>= 32 random chars): `openssl rand -base64 48`
AUTH_SECRET=
SESSION_TTL_DAYS=14

# ---------------------------------------------------------------- database
# Production: PostgreSQL connection string (migrations: `npm run db:migrate`).
# Leave empty in development to use embedded PGlite stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Supabase Auth & API Configuration (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://dtgjgjevkeabewqmpynn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- sign-in (OD-04: providers not yet selected)
# DEMO_MODE=true allows "screen" delivery (code shown on the verify page, nothing sent) and labels the app "Demo".
# For experience walkthroughs only — never for real users.
DEMO_MODE=
# Email codes: "resend" (needs RESEND_API_KEY) | "screen" (demo) | "dev-outbox" (development only: writes .dev-outbox/outbox.jsonl)
EMAIL_PROVIDER=dev-outbox
RESEND_API_KEY=
EMAIL_FROM="TattvaCo <no-reply@your-domain>"
# SMS codes: "twilio" | "screen" (demo) | "dev-outbox" (development only)
SMS_PROVIDER=dev-outbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Google OAuth — authorised redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple — return URL: ${APP_URL}/auth/apple/callback (HTTPS required)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 .p8 key contents; "\n" escapes are accepted
APPLE_PRIVATE_KEY=
# DEVELOPMENT ONLY: comma-separated emails granted the editor role on sign-in (ignored in production)
DEV_EDITOR_EMAILS=

# ---------------------------------------------------------------- AI (OD-09: vendor not yet approved)
# LLM_PROVIDER: "gemini" | "groq" | "anthropic" | "auto" | "none".
# "auto" activates dual failover: Primary Gemini with Groq fallback.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Default: gemini-3.5-flash-lite (Gemini), openai/gpt-oss-120b (Groq), or claude-opus-5-5 (Anthropic)
LLM_MODEL=gemini-3.5-flash-lite
LLM_EFFORT=medium
LLM_TIMEOUT_MS=90000
# Second model pass that can only REMOVE unsupported statements
ANSWER_JUDGE=true

# Retrieval: "corpus" (published TattvaCo content + source excerpts) and/or "wikipedia" (free, external)
RETRIEVAL_PROVIDERS=corpus,wikipedia
RETRIEVAL_TIMEOUT_MS=8000
# Wikimedia API policy: identify the client with a contact URL or email
WIKIPEDIA_USER_AGENT="TattvaCo/0.1 (https://your-domain; ops@your-domain)"

# PROVISIONAL answer thresholds (OD-02)
ANSWER_MIN_PASSAGES=2
ANSWER_MIN_PASSAGE_SCORE=0.3
ANSWER_MIN_COVERAGE=0.8
ANSWER_ABSTAIN_BELOW_COVERAGE=0.5
ANSWER_MIN_SCRIPT_RATIO=0.6
# Languages whose quality gate has formally passed (OD-01). Empty = none: every answer is "shown with limitations".
QUALITY_GATE_PASSED_LANGUAGES=
ASK_RATE_LIMIT_PER_MINUTE=6
ASK_RATE_LIMIT_PER_DAY=100
ASK_SESSION_CONTEXT_TURNS=3

# ---------------------------------------------------------------- content
# Development fixtures are never served in production unless explicitly enabled.
ALLOW_FIXTURE_CONTENT=

# ---------------------------------------------------------------- PROVISIONAL retention (OD-05) — used by `npm run maintenance:purge`
RETENTION_ANSWER_RUNS_DAYS=90
RETENTION_ANALYTICS_DAYS=180
RETENTION_RESOLVED_REPORTS_DAYS=365
