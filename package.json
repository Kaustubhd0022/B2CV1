{
  "name": "tattvaco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "content:ingest": "tsx --conditions=react-server scripts/ingest.ts",
    "seed:dev": "tsx --conditions=react-server scripts/ingest.ts --publish-fixtures",
    "editor:grant": "tsx --conditions=react-server scripts/grant-editor.ts",
    "sources:check": "tsx --conditions=react-server scripts/check-sources.ts",
    "maintenance:purge": "tsx --conditions=react-server scripts/purge.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "clean": "rm -rf .next test-results"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.6.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "type": "module"
}
